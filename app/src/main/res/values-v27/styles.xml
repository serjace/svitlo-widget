<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8.1+: the bottom navigation bar takes the app's background colour,
         with dark or light buttons to match, just like the status bar on top. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
</resources>
