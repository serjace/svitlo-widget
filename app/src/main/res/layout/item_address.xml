<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <!-- Name and address; edit / delete stacked on the right so the text keeps its width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/a_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Показано на головному екрані"
            android:src="@drawable/ic_check"
            android:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/a_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/a_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/a_edit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Редагувати назву й адресу"
                android:src="@drawable/ic_edit"
                android:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/a_delete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Видалити адресу"
                android:src="@drawable/ic_delete"
                android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Notifications on/off: own line, so the word never gets squeezed -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/a_notify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="8dp"
        android:minHeight="48dp"
        android:text="Сповіщення"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp" />

    <!-- Order: only when there are several addresses -->
    <LinearLayout
        android:id="@+id/a_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/a_up"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вище"
            android:textSize="16sp"
            app:icon="@drawable/ic_arrow_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/a_down"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Нижче"
            android:textSize="16sp"
            app:icon="@drawable/ic_arrow_down" />
    </LinearLayout>
</LinearLayout>
