<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Дім · черга 3.2"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="11:17"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/w_switch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Інша адреса"
            android:padding="6dp"
            android:src="@drawable/ic_swap" />

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Оновити"
            android:padding="6dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_on"
            android:contentDescription="Статус"
            android:padding="8dp"
            android:src="@drawable/ic_status_on" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Світло є"
                android:textColor="@color/widget_on"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/w_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Вимкнуть о 14:00 · через 2 год"
                android:textColor="@color/widget_sub"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/w_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="3dp"
        android:background="@color/widget_line"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/w_row1_pill"
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/pill_on" />

        <TextView
            android:id="@+id/w_row1_time"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="зараз–14:00"
            android:textColor="@color/widget_on"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_row1_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Світло є"
            android:textColor="@color/widget_sub"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/w_row2_pill"
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/pill_off" />

        <TextView
            android:id="@+id/w_row2_time"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="14:00–16:00"
            android:textColor="@color/widget_on"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_row2_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Відключення"
            android:textColor="@color/widget_sub"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/w_row3_pill"
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/pill_on" />

        <TextView
            android:id="@+id/w_row3_time"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="16:00–24:00"
            android:textColor="@color/widget_on"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_row3_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Світло є"
            android:textColor="@color/widget_sub"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
