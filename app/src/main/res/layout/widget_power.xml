<?xml version="1.0" encoding="utf-8"?>
<!-- Big widget. Text sizes are set in code (PowerWidget): fixed, times the size chosen in
     Settings, and only a little smaller when a long phrase wouldn't fit the width.
     A taller widget just shows more coming periods. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg_on"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Place name + ⇄ (the ⇄ icon switches the address) -->
    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_pin"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_place" />

        <TextView
            android:id="@+id/w_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Дім"
            android:textColor="#FFFFFFFF"
            android:textSize="18dp" />

        <ImageView
            android:id="@+id/w_switch"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:background="@drawable/switch_pill_light"
            android:contentDescription="Інша адреса"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_swap" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_status_on" />

        <TextView
            android:id="@+id/w_status"
            android:textSize="31dp"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Світло є"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_detail"
        android:textSize="19dp"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="Вимкнуть о 14:00 · через 40 хв"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/w_row1"
        android:textSize="17dp"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="14:00–16:00  світла немає"
        android:textColor="#F2FFFFFF" />

    <TextView
        android:id="@+id/w_row2"
        android:textSize="17dp"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="16:00–16:30  можливе відключення"
        android:textColor="#F2FFFFFF" />

    <TextView
        android:id="@+id/w_row3"
        android:textSize="17dp"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#F2FFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_row4"
        android:textSize="17dp"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#F2FFFFFF"
        android:visibility="gone" />
</LinearLayout>
