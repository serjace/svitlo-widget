<?xml version="1.0" encoding="utf-8"?>
<!-- Big widget, normal text. Every line gets a share of the widget's height and the text
     grows to fill it: a bigger widget means bigger letters. Long words shrink to fit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg_on"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.6"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_pin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:src="@drawable/ic_place" />

        <TextView
            android:id="@+id/w_address"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="24dp"
            android:autoSizeMinTextSize="10dp"
            android:autoSizeStepGranularity="1dp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Дім"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/w_switch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:adjustViewBounds="true"
            android:background="@drawable/switch_pill_light"
            android:contentDescription="Інша адреса"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp"
            android:src="@drawable/ic_swap" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:padding="3dp"
            android:src="@drawable/ic_status_on" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="48dp"
            android:autoSizeMinTextSize="12dp"
            android:autoSizeStepGranularity="1dp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Світло є"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:autoSizeMaxTextSize="30dp"
        android:autoSizeMinTextSize="10dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="Вимкнуть о 14:00 · через 40 хв"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.7"
        android:autoSizeMaxTextSize="24dp"
        android:autoSizeMinTextSize="9dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="14:00–16:00  світла немає"
        android:textColor="#F2FFFFFF" />

    <TextView
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.7"
        android:autoSizeMaxTextSize="24dp"
        android:autoSizeMinTextSize="9dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="16:00–16:30  можливе відключення"
        android:textColor="#F2FFFFFF" />
</LinearLayout>
