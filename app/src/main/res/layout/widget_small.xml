<?xml version="1.0" encoding="utf-8"?>
<!-- Square widget, normal text. Text grows with the widget's size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg_on"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_pin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:src="@drawable/ic_place" />

        <TextView
            android:id="@+id/w_address"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="22dp"
            android:autoSizeMinTextSize="9dp"
            android:autoSizeStepGranularity="1dp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Дім"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/w_switch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:adjustViewBounds="true"
            android:background="@drawable/switch_pill_light"
            android:contentDescription="Інша адреса"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp"
            android:src="@drawable/ic_swap" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.4"
        android:autoSizeMaxTextSize="40dp"
        android:autoSizeMinTextSize="11dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:maxLines="2"
        android:text="Світло є"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/w_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.6"
        android:autoSizeMaxTextSize="30dp"
        android:autoSizeMinTextSize="10dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:text="до 14:00"
        android:textColor="#FFFFFFFF" />
</LinearLayout>
