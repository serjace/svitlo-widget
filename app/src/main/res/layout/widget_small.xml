<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg_on"
    android:padding="16dp">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|start"
        android:contentDescription="@null"
        android:src="@drawable/ic_status_on" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:text="Світло є"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/w_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="до 14:00"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
