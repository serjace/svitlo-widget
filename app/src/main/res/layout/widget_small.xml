<?xml version="1.0" encoding="utf-8"?>
<!-- Square widget. Fixed, large text sizes; content stays at the top. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg_on"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- Place name + ⇄ (the ⇄ icon switches the address) -->
    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_pin"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_place" />

        <TextView
            android:id="@+id/w_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Дім"
            android:textColor="#FFFFFFFF"
            android:textSize="16dp" />

        <ImageView
            android:id="@+id/w_switch"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:background="@drawable/switch_pill_light"
            android:contentDescription="Інша адреса"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_swap" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_status"
        android:textSize="26dp"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:maxLines="2"
        android:text="Світло є"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/w_detail"
        android:textSize="19dp"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:maxLines="2"
        android:text="до 14:00"
        android:textColor="#FFFFFFFF" />
</LinearLayout>
